generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  googleId  String?  @unique
  discordId String?  @unique
  name      String
  avatar    String?
  role      String   @default("user") // user | admin
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  watchHistory   WatchHistory[]
  watchlistItems Watchlist[]
  favorites      Favorite[]

  @@map("users")
}

model Media {
  id          String   @id @default(cuid())
  tmdbId      String   @unique
  title       String
  arabicTitle String?  @map("arabic_title")
  description String   @default("")
  arabicDesc  String?  @map("arabic_desc")
  posterPath  String?  @map("poster_path")
  backdropPath String? @map("backdrop_path")
  releaseDate String?  @map("release_date")
  rating      Float?
  genres      String[]  // array of genre strings
  category    String   // movie | series | anime
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  episodes       Episode[]
  watchHistory   WatchHistory[]
  watchlistItems Watchlist[]
  favorites      Favorite[]
  serverLinks    ServerLink[]

  @@map("media")
}

model Episode {
  id            String  @id @default(cuid())
  mediaId       String  @map("media_id")
  seasonNumber  Int     @map("season_number")
  episodeNumber Int     @map("episode_number")
  title         String  @default("")
  overview      String  @default("")
  stillPath     String? @map("still_path")
  airDate       String? @map("air_date")
  runtime       Int?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  media        Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  watchHistory WatchHistory[]

  @@unique([mediaId, seasonNumber, episodeNumber])
  @@map("episodes")
}

model ServerLink {
  id        String   @id @default(cuid())
  mediaId   String   @map("media_id")
  episodeId String?  @map("episode_id")
  server    String   // arabseed | akwam | vidsrc | embed_su | multiembed | custom
  label     String   // "السيرفر الرئيسي" | "السيرفر البديل" | etc.
  url       String
  type      String   @default("iframe") // iframe | m3u8 | mp4 | embed
  priority  Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  media   Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@map("server_links")
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  mediaId   String   @map("media_id")
  episodeId String?  @map("episode_id")
  progress  Int      @default(0) // seconds watched
  duration  Int      @default(0) // total duration in seconds
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media   Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, episodeId])
  @@map("watch_history")
}

model Watchlist {
  id      String   @id @default(cuid())
  userId  String   @map("user_id")
  mediaId String   @map("media_id")
  addedAt DateTime @default(now()) @map("added_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@map("watchlist")
}

model Favorite {
  id      String   @id @default(cuid())
  userId  String   @map("user_id")
  mediaId String   @map("media_id")
  addedAt DateTime @default(now()) @map("added_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@map("favorites")
}
